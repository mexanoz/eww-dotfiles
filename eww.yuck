(deflisten workspace "scripts/bin/workspace")
(deflisten language :initial "en" "scripts/bin/language")
(deflisten playerctl-status 'playerctl metadata -aFf \'{"status": "{{lc(status)}}", "player": "{{markup_escape(playerName)}}", "artist": "{{markup_escape(artist)}}", "title": "{{markup_escape(title)}}"}\'')
(deflisten network-status :initial '{"icon": "󰩠", "connection": ""}'
    "scripts/network")
(deflisten volume-status :initial '{"icon": "", "volume": ""}'
    "scripts/volume")

;; LEFT

(defwidget workspaces []
    (literal
        :class "workspaces"
        :content workspace))

(defwidget playerctl []
    (box :orientation "h"
         :space-evenly false
         :class "playerctl ${playerctl-status != "" ? playerctl-status.status : ""}"
         :visible {playerctl-status != ""}
         :tooltip {playerctl-status != "" ? "${playerctl-status.artist} - ${playerctl-status.title}" : ""}
         (button :onclick "playerctl previous" "󰒮 ")
         (button :onclick "playerctl play-pause" 
             {playerctl-status != ""
                 ? playerctl-status.status == "playing"
                     ? "󰏥 " 
                     : "󰐌 "
                 : ""})
         (button :onclick "playerctl next" "󰒭 ")))

(defwidget left []
    (box :orientation "h"
         :space-evenly false
         :halign "start"
         (workspaces)
         (playerctl)))

;; CENTER

(defwidget clock []
    (label
        :text { formattime(EWW_TIME, "%a, %-d %B %Y  %H:%M")}
        :class "clock"))

(defwidget center []
    (box :orientation "h"
         :space-evenly false
         :halign "center"
         (clock)))

;; RIGHT

(defwidget tray []
    (systray :space-evenly false))

(defwidget kblayout []
    (eventbox 
        :onclick "hyprctl switchxkblayout main next" 
        :valign "center"
        (label :class "language" :text language)))

(defwidget battery []
    (label :class "battery ${EWW_BATTERY.BAT0.status == "Not charging" && EWW_BATTERY.BAT0.capacity <= 25 ? "warning" : ""}"
           :tooltip "${EWW_BATTERY.BAT0.capacity}%"
           :text "${EWW_BATTERY.BAT0.status =~ "(Full|Not charging)"
                      ? ""
                      : EWW_BATTERY.BAT0.status == "Charging"
                          ? EWW_BATTERY.BAT0.capacity <= 30
                              ? "󱊤"
                              : EWW_BATTERY.BAT0.capacity <= 70
                                  ? "󱊥"
                                  : "󱊦"
                          : EWW_BATTERY.BAT0.capacity <= 30
                              ? "󱊡"
                              : EWW_BATTERY.BAT0.capacity <= 70
                                  ? "󱊢"
                                  : "󱊣"}"))

(defwidget network []
    (eventbox :onrightclick "nm-connection-editor &"
        (label :class "network ${network-status.connection == "disconnected" ? "disconnected" : ""}"
               :text {network-status.icon}
               :tooltip {network-status.connection})))

(defwidget volume []
    (eventbox :onrightclick "pavucontrol &"
        (label :class "volume ${volume-status.volume == "No sink" ? "nosink" : ""}"
               :text {volume-status.icon}
               :tooltip {volume-status.volume})))

(defwidget right []
    (box :orientation "h"
         :space-evenly false
         :halign "end"
         :class "right"
         :spacing 5
         (tray)
         (kblayout)
         (battery)
         (network)
         (volume)))

;; WINDOW

(defwindow bar
    :geometry (geometry
                  :width "100%"
                  :height "22px"
                  :anchor "bottom center")
    :exclusive true
    :stacking "fg"
    :monitor 0
    (box :orientation "h"
         (left)
         (center)
         (right)))
